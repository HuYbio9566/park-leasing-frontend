.home { padding-bottom: 100rpx; }
.hero { height: 560rpx; position: relative; overflow: visible; border-radius: 0; color: #fffdf8; }
.hero-swiper { width: 100%; height: 100%; overflow: hidden; }
.hero-swiper swiper-item { position: relative; }
.hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-image { object-position: 64% center; }
.hero-shade { background: linear-gradient(180deg, rgba(14,35,27,.25) 0%, rgba(14,35,27,.08) 28%, rgba(14,35,27,.68) 76%, rgba(244,246,243,.98) 100%); }
.nav-safe { position: absolute; z-index: 3; top: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: space-between; padding: calc(env(safe-area-inset-top) + 22rpx) 32rpx 0; }
.brand { display: flex; align-items: center; gap: 18rpx; font-size: 28rpx; font-weight: 650; }
.brand-mark { display: grid; place-items: center; width: 64rpx; height: 64rpx; border: 1rpx solid rgba(255,255,255,.55); border-radius: 16rpx; font-size: 20rpx; }
.brand-en { display: block; margin-top: 2rpx; font-size: 14rpx; letter-spacing: 3rpx; opacity: .7; }
.notice { position: relative; display: grid; place-items: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,.88); }
.notice image { width: 34rpx; height: 34rpx; }
.notice-dot { position: absolute; right: 19rpx; top: 18rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #df8a43; }
.hero-copy { position: absolute; left: 40rpx; right: 40rpx; bottom: 168rpx; }
.hero-kicker, .hero-title, .hero-sub { display: block; }
.hero-kicker { font-size: 20rpx; letter-spacing: 5rpx; color: #e6be92; }
.hero-title { max-width: 580rpx; font-size: 60rpx; font-weight: 700; line-height: 1.2; }
.hero-sub { margin-top: 22rpx; max-width: 610rpx; font-size: 25rpx; line-height: 1.8; opacity: .8; }
.hero-dots { position: absolute; z-index: 3; left: 40rpx; bottom: 52rpx; display: flex; gap: 20rpx; }
.hero-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: rgba(255,255,255,.45); }
.hero-dot.active { width: 28rpx; border-radius: 8rpx; background: #fff; }
.hero-facts { position: absolute; z-index: 2; left: 32rpx; right: 32rpx; bottom: -40rpx; display: grid; grid-template-columns: repeat(3, 1fr); padding: 24rpx 20rpx; border: 1rpx solid #e4e8e1; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(35,67,53,.1); color: #18241f; }
.hero-facts view { padding-left: 25rpx; border-left: 1rpx solid #e4e8e1; text-align: center; }
.hero-facts view:first-child { padding-left: 0; border: 0; }
.hero-facts text { display: block; color: #78867c; font-size: 20rpx; }
.hero-facts text:first-child { margin-bottom: 3rpx; color: #245c4a; font-size: 34rpx; font-weight: 600; }
.content { margin-top: 79rpx; }
.service-heading { margin-top: 0; }
.service-heading .section-heading { font-size: 48rpx; }
.service-grid { overflow: hidden; border-radius: 24rpx; background: #fffdf8; box-shadow: 0 12rpx 34rpx rgba(35,67,53,.07); }
.service-icon { padding: 22rpx; border-radius: 24rpx; background: #edf2e9; }
.quick-grid { display: grid; gap: 16rpx; margin-top: 32rpx; }
.quick { display: grid; grid-template-columns: 76rpx 1fr 36rpx; align-items: center; min-height: 116rpx; padding: 20rpx; border-radius: 20rpx; background: #fffdf8; text-align: left; box-shadow: 0 8rpx 30rpx rgba(35,67,53,.06); }
.quick text { display: block; font-size: 28rpx; font-weight: 600; }
.quick text + text { margin-top: 5rpx; color: #78867c; font-size: 21rpx; font-weight: 400; }
.quick-icon { display: grid; place-items: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: #edf2e9; color: #245c4a; font-size: 31rpx; }
.quick .arrow { color: #859087; font-size: 38rpx; font-weight: 300; }
.primary-quick { background: #245c4a; color: #fffdf8; }
.primary-quick .quick-icon { background: rgba(255,255,255,.13); color: #fff; }
.primary-quick text + text, .primary-quick .arrow { color: rgba(255,255,255,.65); }
.space-scroll { width: calc(100% + 32rpx); }
.space-row { display: flex; gap: 22rpx; padding: 0 32rpx 22rpx 0; }
.space-card { flex: none; width: 530rpx; overflow: hidden; text-align: left; }
.image-wrap { position: relative; height: 286rpx; overflow: hidden; }
.image-wrap image { width: 100%; height: 100%; }
.image-wrap .pill { position: absolute; left: 18rpx; top: 18rpx; }
.space-copy { padding: 24rpx; }
.space-name { display: block; font-size: 28rpx; font-weight: 600; }
.space-meta { display: block; margin-top: 10rpx; color: #78867c; font-size: 22rpx; }
.space-price { display: flex; align-items: baseline; margin-top: 23rpx; padding-top: 20rpx; border-top: 1rpx solid #e4e8e1; }
.space-price text:first-child { color: #b36c35; font-size: 34rpx; font-weight: 700; }
.space-price text:last-child { margin-left: 6rpx; color: #78867c; font-size: 19rpx; }
.service-band { display: flex; align-items: center; justify-content: space-between; margin-top: 42rpx; padding: 34rpx 30rpx; border-radius: 22rpx; background: #1d3028; color: #fff; }
.service-title, .service-sub { display: block; }
.service-title { margin-top: 12rpx; font-family: "STSong", "Songti SC", serif; font-size: 34rpx; }
.service-sub { margin-top: 10rpx; color: rgba(255,255,255,.6); font-size: 21rpx; }
.service-arrow { display: grid; place-items: center; min-width: 84rpx; height: 84rpx; border: 1rpx solid rgba(255,255,255,.26); border-radius: 50%; color: #fff; font-size: 34rpx; }
.hero-facts { border: 0; }
