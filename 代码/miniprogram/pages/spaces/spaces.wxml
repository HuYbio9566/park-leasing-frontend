<view class="page spaces-page">
  <view class="page-intro"><text class="eyebrow">FIND YOUR SPACE</text><text class="page-title">找到适合团队的空间</text><text class="intro-sub">公开在租房源，价格与可预约状态同步更新。</text></view>
  <view class="meeting-filters card space-filters"><picker mode="selector" range="{{buildingOptions}}" value="{{buildingOptions.indexOf(building)}}" data-key="building" bindchange="pickerChange"><view class="filter-select"><text>{{building}}</text><text class="select-arrow">⌄</text></view></picker><picker mode="selector" range="{{finishOptions}}" value="{{finishOptions.indexOf(finish)}}" data-key="finish" bindchange="pickerChange"><view class="filter-select"><text>{{finish}}</text><text class="select-arrow">⌄</text></view></picker><picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" data-key="sort" bindchange="pickerChange"><view class="filter-select"><text>{{sort}}</text><text class="select-arrow">⌄</text></view></picker></view>
  <view class="result-head"><text>找到 {{filtered.length}} 处可预约空间</text><text class="muted">可预约看房</text></view>
  <view class="listing"><button wx:for="{{filtered}}" wx:key="id" class="listing-card card" data-id="{{item.id}}" bindtap="open"><image src="{{item.image}}" mode="aspectFill"/><view class="listing-body"><view class="listing-top"><text class="listing-name">{{item.building}} · {{item.area}}㎡ {{item.type}}</text><text class="pill">在租</text></view><text class="listing-meta">{{item.id}} · {{item.floor}} · {{item.finish}}</text><view class="listing-bottom"><text class="rent">¥{{item.price}}<text>/㎡/月起</text></text><text class="detail-link">查看详情 ›</text></view></view></button></view>
  <view wx:if="{{!filtered.length}}" class="empty card"><text>暂时没有匹配的空间</text><text class="muted">试试放宽面积或装修条件。</text></view>
</view>
